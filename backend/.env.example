# ── Backend environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in real values before running the server.

# JWT signing secret – change this to a long random string in production
SECRET_KEY=your-super-secret-key-change-me

# Token expiry in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./auralix.db
# DATABASE_URL=postgresql://user:password@localhost:5432/auralix_db

# CORS – comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173
